# Configuración de Base de Datos MySQL (phpMyAdmin / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=database

# Secreto Criptográfico (Pepper) para HMAC-SHA256 + Argon2id
# Genera uno aleatorio de al menos 32 bytes (ej. python -c "import secrets; print(secrets.token_hex(32))")
PEPPER_SECRET=cambia_este_secreto_por_una_cadena_hexadecimal_de_64_caracteres_minimo
